# StudyForge Web — environment variables
# Copy to .env.local and fill in values.
# NEXT_PUBLIC_* vars are baked into the JS bundle at build time (see Dockerfile ARGs).

# ── API ───────────────────────────────────────────────────────────────────────
# Local:      http://localhost:8000
# Production: https://studyforge-api-xxxx-ew.a.run.app  (your Cloud Run URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Clerk authentication ───────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs (defaults shown; override if using a custom domain)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
