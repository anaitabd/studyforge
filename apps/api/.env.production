# Production environment template — values injected via Secret Manager / Cloud Run env vars.
# Do NOT put real secrets here. This file is committed as documentation only.

# ── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=studyforge-495618
GCP_LOCATION=europe-west9
GCS_BUCKET=studyforge-495618-files

# ── AI ────────────────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-multilingual-embedding-002

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
TASK_EXECUTION_MODE=celery

