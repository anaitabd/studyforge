# StudyForge API — environment variables
# Copy to .env and fill in values for your environment.
# Production values come from GCP Secret Manager.

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=local                          # local | dev | staging | prod
SECRET_KEY=change-me-in-production
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=                         # comma-separated; overrides per-env defaults
API_BASE_URL=http://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://studyforge:studyforge@localhost:5432/studyforge

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI provider ───────────────────────────────────────────────────────────────
# Options: gemini (default) | claude_vertex
AI_PROVIDER=gemini

# On Cloud Run: ADC is automatic. Locally: gcloud auth application-default login
GCP_PROJECT_ID=
GCP_LOCATION=europe-west9
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-multilingual-embedding-002

# ── Storage (Google Cloud Storage) ───────────────────────────────────────────
GCS_BUCKET=                            # e.g. my-project-files
GCS_EMULATOR_HOST=                     # http://localhost:4443 for fake-gcs-server

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=chroma_server
CHROMA_PORT=8000

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# ── Notifications (Twilio WhatsApp) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Payments (PayPal) ────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# ── Task queue ────────────────────────────────────────────────────────────────
TASK_EXECUTION_MODE=celery
