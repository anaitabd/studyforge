# StudyForge API — environment variables
# Copy to .env and fill in values for your environment.
# Production values come from GCP Secret Manager (see cloudbuild.yaml).

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=local                          # local | dev | staging | prod
SECRET_KEY=change-me-in-production
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=                         # comma-separated; overrides per-env defaults

# ── Database ──────────────────────────────────────────────────────────────────
# Local:      postgresql+asyncpg://studyforge:studyforge@localhost:5432/studyforge
# Cloud Run:  postgresql+asyncpg://postgres:<PW>@/studyforge?host=/cloudsql/PROJECT:REGION:studyforge-db
DATABASE_URL=postgresql+asyncpg://studyforge:studyforge@localhost:5432/studyforge

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local:      redis://localhost:6379/0
# Memorystore: redis://10.x.x.x:6379/0
REDIS_URL=redis://localhost:6379/0

# ── AI provider ───────────────────────────────────────────────────────────────
# Options: gemini_vertex | openai | nvidia | ollama | bedrock
AI_PROVIDER=gemini_vertex

# Gemini / Vertex AI  (AI_PROVIDER=gemini_vertex)
# On Cloud Run: ADC is automatic. Locally: gcloud auth application-default login
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=europe-west9
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# OpenAI-compatible  (AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=                       # leave empty for api.openai.com
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# NVIDIA NIM  (AI_PROVIDER=nvidia)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_RERANK_MODEL=nvidia/nv-rerankqa-mistral-4b-v3

# Ollama local  (AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# AWS Bedrock (legacy)
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ── Storage ───────────────────────────────────────────────────────────────────
# GCS (production on GCP) — set GCS_BUCKET to activate GCS backend
GCS_BUCKET=                            # e.g. studyforge-PROJECT_ID-files
GCS_EMULATOR_HOST=                     # http://localhost:4443 for fake-gcs-server

# S3-compatible (local MinIO / R2) — used when GCS_BUCKET is empty
S3_BUCKET=studyforge
S3_REGION=us-east-1
S3_ENDPOINT_URL=                       # e.g. http://localhost:9000 for MinIO
S3_AUTO_CREATE_BUCKET=false
S3_USE_AWS_MANAGED_CREDENTIALS=true
S3_SERVER_SIDE_ENCRYPTION=             # AES256 | aws:kms (leave empty for none)
S3_KMS_KEY_ID=

# Legacy R2/MinIO credentials (static — prefer IAM roles in production)
R2_BUCKET=
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY=minioadmin
R2_SECRET_KEY=minioadmin

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=chroma_server              # docker-compose service name or GCE/Cloud Run host
CHROMA_PORT=8000

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# ── Notifications ─────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Payments ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PERSONAL_MONTHLY_PRICE_ID=
STRIPE_PERSONAL_ANNUAL_PRICE_ID=
# Moroccan CMI gateway
CMI_CLIENT_ID=
CMI_PAYMENT_URL=https://payment.cmi.co.ma/fim/est3Dgate
CMI_STORE_KEY=

# ── Task queue ────────────────────────────────────────────────────────────────
TASK_EXECUTION_MODE=celery             # celery | hybrid | lambda

# SQS (used when TASK_EXECUTION_MODE=lambda or hybrid)
TASK_SQS_FILE_QUEUE_URL=
TASK_SQS_SLIDE_QUEUE_URL=
TASK_SQS_NOTIFICATION_QUEUE_URL=
TASK_EVENTBRIDGE_EXAM_DEADLINE_RULE=

# ── API base URL (used in notifications / webhooks) ───────────────────────────
API_BASE_URL=http://localhost:8000
